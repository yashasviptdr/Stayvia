# ==============================================================================
# Stayvia Environment Configuration Example
# ==============================================================================
# Copy this file to a new file named `.env` in the same directory:
#   copy .env.example .env   (Windows PowerShell)
#
# NOTE: Do NOT commit your real `.env` file to version control.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# MySQL Database Configuration
# Provide your MySQL connection credentials below when your database is ready.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=stayvia_db
DB_CONNECTION_LIMIT=10

# Security (for future authentication phases)
JWT_SECRET=replace_with_a_long_random_secret_key_in_future
SESSION_SECRET=replace_with_a_session_secret_in_future
